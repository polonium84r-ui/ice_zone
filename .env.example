# PostgreSQL connection (local dev: docker compose up -d db)
DATABASE_URL="postgresql://thirst:thirst@localhost:5432/thirst?schema=public"

# Fixed JWT signing secret — REQUIRED in production so sessions survive restarts.
# THIRST_JWT_SECRET="a-long-random-secret"

# Bootstrap accounts (used by the seed; change after first login)
# THIRST_ADMIN_EMAIL="admin@thirst.in"
# THIRST_ADMIN_PASSWORD="ChangeMe@123"
# THIRST_STAFF_EMAIL="staff@thirst.in"
# THIRST_STAFF_PASSWORD="ChangeMe@123"
